---
import PawIcon from '@/assets/icons/paw.svg';
import HeartSparkleIcon from '@/assets/icons/heart-sparkle.svg';
import WhatsAppIcon from '@/assets/icons/whatsapp.svg';
import PhoneIcon from '@/assets/icons/phone.svg';
import { SITE_CONFIG, buildWhatsAppUrl } from '@/data/doglife';

const primaryOrderUrl = buildWhatsAppUrl(
  'Hola DogLife, quiero hacer un pedido de patitas deshidratadas'
);
const secondaryOrderUrl = buildWhatsAppUrl(
  'Hola DogLife Store, quisiera información y precios de patitas',
  SITE_CONFIG.whatsappSecondary
);
---

<section
  id="contacto"
  style="--section-intrinsic-height: 440px;"
  class="deferred-section w-full px-margin-mobile md:px-0 py-4 md:py-0"
>
  <div
    class="w-full rounded-2xl md:rounded-none bg-primary text-on-primary py-10 md:py-24 px-5 md:px-margin relative overflow-hidden shadow-xl md:shadow-none"
  >
    <div class="max-w-[1080px] mx-auto text-center space-y-space-md md:space-y-space-lg relative z-10">
      <div class="flex flex-col items-center gap-space-sm">
        <span
          class="md:hidden w-12 h-12 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center"
        >
          <PawIcon class="w-6 h-6" aria-hidden="true" />
        </span>

        <span
          class="inline-flex items-center gap-space-xs px-space-md py-1 rounded-full bg-secondary-container text-on-secondary-container text-label-sm"
        >
          <HeartSparkleIcon class="w-4 h-4" aria-hidden="true" />
          <span>Pide hoy y recibe el regalo de degustación</span>
        </span>
      </div>

      <h2 class="fluid-hero-title text-on-primary max-w-3xl mx-auto">
        Haz que la hora del premio sea el momento más saludable de su día.
      </h2>

      <p class="text-body-md md:text-body-lg text-surface-container-high max-w-2xl mx-auto leading-relaxed">
        Pide directamente por WhatsApp. Coordinamos tu entrega en minutos con delivery express a
        todo Lima Metropolitana.
      </p>

      <div class="pt-space-xs flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center justify-center gap-3 md:gap-space-md max-w-md sm:max-w-none mx-auto">
        <a
          href={primaryOrderUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-space-xs px-space-xl py-3.5 md:py-space-md min-h-12 rounded-full bg-honey text-roasted text-label-lg md:text-title-lg font-bold shadow-xl hover:bg-secondary-container transition-all duration-200 hover:-translate-y-0.5"
        >
          <WhatsAppIcon class="w-5 h-5 shrink-0" aria-hidden="true" />
          <span>Pedir por WhatsApp al {SITE_CONFIG.phoneDisplay}</span>
        </a>

        <a
          href={secondaryOrderUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="sm:hidden inline-flex items-center justify-center gap-1.5 px-space-md py-3 min-h-11 rounded-full bg-primary-container text-surface-bright text-label-md transition-colors hover:bg-mocha-hover"
        >
          <PhoneIcon class="w-4 h-4 shrink-0" aria-hidden="true" />
          <span>Línea Secundaria: {SITE_CONFIG.secondaryPhoneDisplay}</span>
        </a>
      </div>

      <p class="text-label-sm font-medium text-surface-container-high/90">
        Lima Metropolitana • Pagos con Yape, Plin y Transferencias • RUC {SITE_CONFIG.ruc}
      </p>
    </div>
  </div>
</section>
