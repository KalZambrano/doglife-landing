---
import WhatsAppIcon from '@/assets/icons/whatsapp.svg';
import TruckIcon from '@/assets/icons/truck.svg';
import VerifiedIcon from '@/assets/icons/verified.svg';
import ChevronDownIcon from '@/assets/icons/chevron-down.svg';
import PawPrintIcon from '@/assets/icons/paw-print.svg';
import DogSittingSilhouette from '@/assets/icons/dog-sitting-silhouette.svg';
import StepWhatsAppIllustration from '@/assets/icons/step-whatsapp.svg';
import StepDeliveryIllustration from '@/assets/icons/step-delivery.svg';
import StepPaymentIllustration from '@/assets/icons/step-payment.svg';
import { ORDER_STEPS } from '@/data/doglife';

const illustrationMap = {
  whatsapp: StepWhatsAppIllustration,
  delivery: StepDeliveryIllustration,
  payment: StepPaymentIllustration,
} as const;
---

<section
  id="como-pedir"
  style="--section-intrinsic-height: 600px;"
  class="deferred-section w-full bg-surface-container-high py-8 md:py-18 px-margin-mobile md:px-margin relative overflow-x-clip"
>
  <div class="max-w-7xl mx-auto space-y-5 md:space-y-space-xl">
    <div class="text-center max-w-2xl mx-auto space-y-space-xs">
      <span class="text-label-sm uppercase tracking-widest text-secondary">
        Proceso Fácil en 3 Pasos
      </span>
      <h2 class="fluid-section-title text-primary">
        <span class="md:hidden">¿Cómo pedir tu pack en Lima?</span>
        <span class="hidden md:inline">Tu pedido listo en minutos</span>
      </h2>
      <p class="text-body-sm md:text-body-md text-on-surface-variant">
        Atendemos de lunes a sábado de 9:00 am a 7:00 pm con entregas el mismo día.
      </p>
    </div>

    <ol
      role="list"
      data-steps-track
      class="order-steps-track -mx-margin-mobile px-margin-mobile pt-2 pb-6 -mt-2 -mb-4 md:-mx-margin md:px-margin lg:mx-0 lg:px-0 lg:py-0 lg:my-0"
    >
      {
        ORDER_STEPS.map((item) => {
          const StepIllustration = illustrationMap[item.id];
          return (
            <li
              data-step-slide
              class="boutique-card order-step-card relative overflow-clip rounded-2xl p-5 md:p-6 snap-center snap-always"
            >
              <!-- Decorative Background Watermarks (Paw Trail + Sitting Dog Silhouette) -->
              <div
                aria-hidden="true"
                class="pointer-events-none select-none absolute inset-0 z-0"
              >
                <PawPrintIcon
                  class="absolute top-5 left-[23%] h-6 w-6 -rotate-16 text-caramel/15"
                  aria-hidden="true"
                />
                <PawPrintIcon
                  class="absolute top-11 left-[34%] h-5 w-5 rotate-12 text-caramel/12"
                  aria-hidden="true"
                />
                <PawPrintIcon
                  class="absolute bottom-16 right-4 h-6 w-6 rotate-12 text-caramel/14"
                  aria-hidden="true"
                />
                <DogSittingSilhouette
                  class="absolute -bottom-1 right-1.5 h-15 w-13 text-caramel/14"
                  aria-hidden="true"
                />
              </div>

              <!-- Subgrid Row 1 (1fr): Step Header, Bespoke Illustration & Copy -->
              <div class="order-step-body relative z-10 flex flex-col gap-2.5">
                <div
                  class:list={[
                    'order-step-hero',
                    item.id !== 'payment' && 'order-step-hero--side',
                  ]}
                >
                  <span
                    aria-hidden="true"
                    class="order-step-num flex h-11 w-11 md:h-12 md:w-12 shrink-0 items-center justify-center rounded-full bg-secondary-container font-sans text-title-lg font-bold text-primary shadow-xs"
                  >
                    {item.step}
                  </span>

                  <div class="order-step-media relative flex justify-end">
                    {item.highlightBadge && (
                      <span class="absolute top-0 right-0 z-10 inline-flex items-center gap-1.5 rounded-full border border-secondary-fixed-dim bg-secondary-container px-3 py-1 text-label-sm font-bold text-primary shadow-xs">
                        <VerifiedIcon class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
                        <span>{item.highlightBadge}</span>
                      </span>
                    )}

                    <StepIllustration
                      class:list={[
                        'block h-auto select-none',
                        item.id === 'payment'
                          ? 'w-full max-w-48 -mt-2 -mb-3'
                          : 'w-full max-w-44 -mt-1.5',
                      ]}
                      aria-hidden="true"
                    />
                  </div>

                  <h3 class="order-step-title font-sans text-title-lg md:text-headline-sm font-bold leading-snug text-primary text-balance">
                    {item.title}
                  </h3>
                </div>

                <p class="text-body-sm md:text-body-md leading-relaxed text-on-surface-variant">
                  {item.description}
                </p>
              </div>

              <!-- Subgrid Row 2 (auto): Even, Colinear Card Footer -->
              <footer class="order-step-footer relative z-10 flex min-h-9 items-center border-t border-craft-border pt-3.5">
                {item.badgeText && (
                  <div class="flex items-center gap-2.5 text-label-md text-primary">
                    <span
                      class:list={[
                        'flex h-8 w-8 shrink-0 items-center justify-center rounded-full',
                        item.footerIcon === 'whatsapp'
                          ? 'bg-sage/18 text-primary'
                          : 'bg-secondary-fixed text-primary',
                      ]}
                    >
                      {item.footerIcon === 'whatsapp' ? (
                        <WhatsAppIcon class="h-4 w-4 shrink-0" aria-hidden="true" />
                      ) : (
                        <TruckIcon class="h-4 w-4 shrink-0" aria-hidden="true" />
                      )}
                    </span>
                    <span class="font-semibold">{item.badgeText}</span>
                  </div>
                )}

                {item.paymentTags && (
                  <ul role="list" class="order-step-tags">
                    {item.paymentTags.map((tag) => (
                      <li class="rounded-full border border-pill-border bg-pill-bg px-3 py-1 text-label-md font-semibold text-primary">
                        {tag}
                      </li>
                    ))}
                  </ul>
                )}
              </footer>
            </li>
          );
        })
      }
    </ol>

    <!-- Stepped Slider Navigation Controls (Mobile & Tablet < lg) -->
    <div
      data-steps-controls
      class="lg:hidden flex items-center justify-between gap-2 pt-1"
    >
      <button
        type="button"
        data-step-prev
        aria-label="Paso anterior"
        aria-disabled="true"
        class="order-step-arrow flex min-h-10 min-w-10 shrink-0 items-center justify-center rounded-full border border-craft-border bg-eggshell text-primary shadow-xs transition-colors hover:bg-surface-container-low"
      >
        <ChevronDownIcon class="h-5 w-5 rotate-90" aria-hidden="true" />
      </button>

      <div
        role="group"
        aria-label="Pasos de compra"
        class="flex items-center justify-center gap-1.5 sm:gap-2"
      >
        {
          ORDER_STEPS.map((item, idx) => (
            <button
              type="button"
              data-step-dot={idx}
              aria-current={idx === 0 ? 'true' : undefined}
              class="order-step-pill inline-flex min-h-9 items-center gap-1.5 rounded-full px-3 py-1.5 text-label-md font-semibold"
            >
              <span>Paso {item.step}</span>
              <span class="hidden sm:inline text-label-sm opacity-80">
                {' '}• {item.shortLabel}
              </span>
            </button>
          ))
        }
      </div>

      <button
        type="button"
        data-step-next
        aria-label="Siguiente paso"
        aria-disabled="false"
        class="order-step-arrow flex min-h-10 min-w-10 shrink-0 items-center justify-center rounded-full border border-craft-border bg-eggshell text-primary shadow-xs transition-colors hover:bg-surface-container-low"
      >
        <ChevronDownIcon class="h-5 w-5 -rotate-90" aria-hidden="true" />
      </button>
    </div>
  </div>
</section>

<script>
  const section = document.getElementById('como-pedir');
  const track = section?.querySelector<HTMLElement>('[data-steps-track]');
  const items = track
    ? Array.from(track.querySelectorAll<HTMLElement>('[data-step-slide]'))
    : [];
  const dots = section
    ? Array.from(section.querySelectorAll<HTMLButtonElement>('[data-step-dot]'))
    : [];
  const prevBtn = section?.querySelector<HTMLButtonElement>('[data-step-prev]');
  const nextBtn = section?.querySelector<HTMLButtonElement>('[data-step-next]');

  if (track && items.length > 0 && dots.length === items.length) {
    let activeIndex = 0;

    const findClosestItemIndex = () => {
      const trackRect = track.getBoundingClientRect();
      const containerCenter = trackRect.left + trackRect.width / 2;
      let closestIndex = 0;
      let minDistance = Infinity;

      items.forEach((item, index) => {
        const itemRect = item.getBoundingClientRect();
        const itemCenter = itemRect.left + itemRect.width / 2;
        const distance = Math.abs(containerCenter - itemCenter);
        if (distance < minDistance) {
          minDistance = distance;
          closestIndex = index;
        }
      });

      return closestIndex;
    };

    const setPendingIndex = (index: number) => {
      if (index < 0 || index >= dots.length) return;
      dots.forEach((dot) => dot.classList.remove('is-pending'));
      dots[index].classList.add('is-pending');
    };

    const setActiveIndex = (index: number) => {
      if (index < 0 || index >= dots.length) return;
      activeIndex = index;

      dots.forEach((dot, idx) => {
        dot.classList.remove('is-pending');
        if (idx === index) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });

      prevBtn?.setAttribute('aria-disabled', index <= 0 ? 'true' : 'false');
      nextBtn?.setAttribute(
        'aria-disabled',
        index >= items.length - 1 ? 'true' : 'false'
      );
    };

    const scrollToStep = (index: number) => {
      const targetIndex = Math.max(0, Math.min(items.length - 1, index));
      const targetItem = items[targetIndex];
      if (!targetItem) return;

      const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
      const trackRect = track.getBoundingClientRect();
      const itemRect = targetItem.getBoundingClientRect();
      const delta =
        itemRect.left + itemRect.width / 2 - (trackRect.left + trackRect.width / 2);
      const targetLeft = Math.max(
        0,
        Math.min(maxScroll, track.scrollLeft + delta)
      );

      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      track.scrollTo({
        left: targetLeft,
        behavior: prefersReducedMotion ? 'instant' : 'smooth',
      });

      if (prefersReducedMotion || Math.abs(track.scrollLeft - targetLeft) < 2) {
        setActiveIndex(targetIndex);
      } else {
        setPendingIndex(targetIndex);
      }
    };

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => scrollToStep(idx));
    });

    prevBtn?.addEventListener('click', () => {
      if (prevBtn.getAttribute('aria-disabled') === 'true') return;
      scrollToStep(activeIndex - 1);
    });

    nextBtn?.addEventListener('click', () => {
      if (nextBtn.getAttribute('aria-disabled') === 'true') return;
      scrollToStep(activeIndex + 1);
    });

    if ('onscrollsnapchanging' in Element.prototype) {
      track.addEventListener('scrollsnapchanging', (event) => {
        const snapEvent = event as Event & { snapTargetInline?: Element | null };
        const pendingTarget = snapEvent.snapTargetInline as HTMLElement | null;
        if (!pendingTarget) return;
        const index = items.indexOf(pendingTarget);
        if (index !== -1) setPendingIndex(index);
      });

      track.addEventListener('scrollsnapchange', (event) => {
        const snapEvent = event as Event & { snapTargetInline?: Element | null };
        const snappedTarget = snapEvent.snapTargetInline as HTMLElement | null;
        if (!snappedTarget) return;
        const index = items.indexOf(snappedTarget);
        if (index !== -1) setActiveIndex(index);
      });
    } else {
      let scrollTimeout: ReturnType<typeof setTimeout> | undefined;
      let rafId: number | null = null;

      const promotePendingToActive = () => {
        setActiveIndex(findClosestItemIndex());
      };

      track.addEventListener(
        'scroll',
        () => {
          if (rafId === null) {
            rafId = requestAnimationFrame(() => {
              rafId = null;
              setPendingIndex(findClosestItemIndex());
            });
          }

          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(promotePendingToActive, 100);
        },
        { passive: true }
      );

      track.addEventListener(
        'scrollend',
        () => {
          clearTimeout(scrollTimeout);
          promotePendingToActive();
        },
        { passive: true }
      );
    }

    const initActiveStep = () => {
      setActiveIndex(findClosestItemIndex());
    };

    window.addEventListener('resize', initActiveStep, { passive: true });

    if (document.readyState === 'complete') {
      initActiveStep();
    } else {
      window.addEventListener('load', initActiveStep, { once: true });
    }
  }
</script>
