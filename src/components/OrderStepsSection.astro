---
import WhatsAppIcon from '@/assets/icons/whatsapp.svg';
import TruckIcon from '@/assets/icons/truck.svg';
import { ORDER_STEPS } from '@/data/doglife';
---

<section
  id="como-pedir"
  style="--section-intrinsic-height: 520px;"
  class="deferred-section w-full bg-surface-container-high py-8 md:py-[72px] px-margin-mobile md:px-margin relative"
>
  <div class="max-w-[1280px] mx-auto space-y-6 md:space-y-space-xl">
    <div class="text-center max-w-2xl mx-auto space-y-space-xs">
      <span class="text-label-sm uppercase tracking-widest text-secondary">
        Proceso Fácil en 3 Pasos
      </span>
      <h2 class="fluid-section-title text-primary">
        <span class="md:hidden">¿Cómo pedir tu pack en Lima?</span>
        <span class="hidden md:inline">Tu pedido listo en minutos</span>
      </h2>
      <p class="text-body-sm md:text-body-md text-on-surface-variant">
        Atendemos de lunes a sábado de 9:00 am a 7:00 pm con entregas el mismo día.
      </p>
    </div>

    <ol role="list" class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-space-lg">
      {
        ORDER_STEPS.map((item) => (
          <li class="boutique-card rounded-2xl p-4 md:p-space-lg flex md:flex-col items-start gap-3.5 md:gap-space-sm">
            <span
              aria-hidden="true"
              class="w-10 h-10 rounded-full bg-mocha text-eggshell flex items-center justify-center font-display font-bold text-headline-sm shrink-0"
            >
              {item.step}
            </span>

            <div class="space-y-1.5 md:space-y-space-xs flex-1">
              <h3 class="font-sans font-semibold text-title-md md:font-display md:text-headline-sm text-primary">
                {item.title}
              </h3>
              <p class="text-body-sm md:text-body-md text-on-surface-variant">{item.description}</p>

              {item.badgeText && (
                <div class="pt-1 text-secondary flex items-center gap-1.5 text-label-sm">
                  {item.step === 1 ? (
                    <WhatsAppIcon class="w-4 h-4 shrink-0" aria-hidden="true" />
                  ) : (
                    <TruckIcon class="w-4 h-4 shrink-0" aria-hidden="true" />
                  )}
                  <span>{item.badgeText}</span>
                </div>
              )}

              {item.paymentTags && (
                <div class="pt-1 flex items-center gap-1.5 flex-wrap">
                  {item.paymentTags.map((tag) => (
                    <span class="px-2.5 py-0.5 rounded-full bg-pill-bg border border-pill-border text-label-sm text-mocha">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
