---
import InstagramIcon from '@/assets/icons/instagram.svg';
import PawIcon from '@/assets/icons/paw.svg';
import WhatsAppIcon from '@/assets/icons/whatsapp.svg';
import { SITE_CONFIG, buildWhatsAppUrl } from '@/data/doglife';

const footerChatUrl = buildWhatsAppUrl(
  'Hola DogLife Store, tengo una consulta sobre sus patitas deshidratadas'
);
---

<footer
  class="w-full border-t border-craft-border bg-surface-container-low text-on-surface-variant pb-20 md:pb-0"
>
  <div class="mx-auto max-w-7xl px-margin-mobile py-space-lg md:px-margin">
    <div class="flex flex-col items-center justify-between gap-space-md md:flex-row">
      <!-- Marca -->
      <div class="flex flex-col items-center gap-1 md:items-start">
        <div class="flex items-center gap-space-xs">
          <PawIcon class="h-6 w-6 text-mocha" aria-hidden="true" />
          <span class="font-display text-title-lg text-primary">{SITE_CONFIG.brandName}</span>
        </div>
        <p class="text-label-sm text-on-surface-variant">
          Snacks 100% naturales • Lima, Perú
        </p>
      </div>

      <!-- Enlaces de navegación -->
      <nav aria-label="Enlaces del pie de página">
        <ul
          role="list"
          class="flex flex-wrap items-center justify-center gap-x-space-md gap-y-1 text-body-sm"
        >
          <li>
            <a href="#catalogo-packs" class="inline-block py-1 transition-colors hover:text-primary">
              Packs
            </a>
          </li>
          <li>
            <a href="#beneficios" class="inline-block py-1 transition-colors hover:text-primary">
              Beneficios
            </a>
          </li>
          <li>
            <a href="#consumo-seguro" class="inline-block py-1 transition-colors hover:text-primary">
              Consumo seguro
            </a>
          </li>
          <li>
            <a href="#faq" class="inline-block py-1 transition-colors hover:text-primary">
              Preguntas frecuentes
            </a>
          </li>
          <li>
            <a href="#como-pedir" class="inline-block py-1 transition-colors hover:text-primary">
              Cómo pedir
            </a>
          </li>
        </ul>
      </nav>

      <!-- Redes sociales (solo iconos) -->
      <div class="flex items-center gap-space-sm">
        <a
          href={footerChatUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp de DogLife Store"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-pill-border bg-pill-bg text-primary transition-colors hover:border-secondary-fixed-dim hover:bg-secondary-container"
        >
          <WhatsAppIcon class="h-5 w-5" aria-hidden="true" />
        </a>
        <a
          href={SITE_CONFIG.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram de DogLife Store"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-pill-border bg-pill-bg text-primary transition-colors hover:border-secondary-fixed-dim hover:bg-secondary-container"
        >
          <InstagramIcon class="h-5 w-5" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</footer>
