---

<div
  aria-hidden="true"
  class="pointer-events-none select-none absolute inset-0 z-0 overflow-hidden"
>
  <!-- Desktop Panoramic Puppy Walk Trail -->
  <div class="hero-paw-trail hidden lg:block relative w-full max-w-[1520px] h-full mx-auto">
    {
      DESKTOP_PAW_STEPS.map((paw, index) => (
        <span
          class="hero-paw-step w-14 h-14 xl:w-16 xl:h-16"
          style={`--paw-x: ${paw.x}%; --paw-y: ${paw.y}%; --paw-angle: ${paw.r}deg; --sibling-index: ${index + 1};`}
        >
          <PawPrintIcon class="w-full h-full" aria-hidden="true" />
        </span>
      ))
    }
  </div>

  <!-- Mobile & Tablet Puppy Walk Trail -->
  <div class="hero-paw-trail lg:hidden relative w-full h-full">
    {
      MOBILE_PAW_STEPS.map((paw, index) => (
        <span
          class="hero-paw-step w-10 h-10 sm:w-12 sm:h-12"
          style={`--paw-x: ${paw.x}%; --paw-y: ${paw.y}%; --paw-angle: ${paw.r}deg; --sibling-index: ${index + 1};`}
        >
          <PawPrintIcon class="w-full h-full" aria-hidden="true" />
        </span>
      ))
    }
  </div>
</div>
