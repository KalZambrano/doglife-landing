// Art-directed mobile/tablet puppy-walk S-curve from top-right down toward CTAs & social proof.
const MOBILE_PAW_STEPS: PawStep[] = [
  { x: 89.8, y: 4.2, r: -123.5 },
  { x: 76.2, y: 3.5, r: -114.1 },
  { x: 66.5, y: 11.1, r: -128.2 },
  { x: 52.8, y: 10.9, r: -116.9 },
